# Скопируй в secrets.yaml (рядом с panel-saray.yaml) и заполни.
# secrets.yaml в репозиторий НЕ коммить — он в .gitignore.

wifi_ssid: "имя_сети"
wifi_password: "пароль_сети"
# пароль точки доступа, которую панель поднимет, если не найдёт Wi-Fi
ap_password: "придумай_пароль"

# ключ шифрования API ESPHome <-> Home Assistant (32 случайных байта в base64):
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
panel_saray_api_key: "ВСТАВЬ_СЮДА_КЛЮЧ"

# координаты места — панель сама считает высоту солнца (яркость день/ночь)
latitude: "55.75"
longitude: "37.62"
